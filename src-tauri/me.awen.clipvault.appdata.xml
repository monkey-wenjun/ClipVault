<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>me.awen.clipvault</id>
  <name>ClipVault</name>
  <summary>Clipboard manager with encrypted sync and image hosting</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <description>
    <p>
      ClipVault is a clipboard manager that keeps your copy history searchable
      and at your fingertips, and uploads screenshots to your own image
      hosting service with one click.
    </p>
    <ul>
      <li>Clipboard history with tags, favorites and full-text search</li>
      <li>AES-256 end-to-end encrypted sync through your own cloud drive</li>
      <li>One-click upload of screenshots to image hosting services</li>
      <li>Global shortcuts for quick paste and image upload</li>
      <li>Exclude sensitive apps, such as password managers</li>
      <li>Light and dark themes; user interface in English, Japanese and Chinese</li>
    </ul>
  </description>
